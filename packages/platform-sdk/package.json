{
  "name": "@platform/sdk",
  "version": "0.1.0",
  "description": "Stable platform-facing contracts (application identity, auth, permissions, tenant, navigation, runtime) for Platform MFE applications.",
  "type": "module",
  "license": "MIT",
  "backstage": {
    "role": "web-library"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "jose": "^5.10.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist",
    "lint": "node ../../node_modules/@backstage/cli/bin/backstage-cli package lint",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "peerDependencies": {
    "react": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/react": "^19.2.18",
    "react": "^19.2.8",
    "typescript": "^5.9.2"
  }
}
