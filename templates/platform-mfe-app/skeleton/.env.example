# Environment configuration for ${{ values.title }}
#
# Copy this file to `.env` (or `.env.local`) and adjust the values.
# Only variables prefixed with VITE_ are exposed to the browser bundle.
# Values are validated by `src/lib/env.ts` (zod) when the app boots, so a
# malformed value fails fast with a readable message instead of surfacing
# as a runtime 404 later.

# Base URL of the backend API the application talks to.
# Must be a valid absolute URL. Optional - defaults to the value below.
VITE_API_BASE_URL=http://localhost:8080/api

# Optional override for the document / header title. When unset the app
# falls back to the title baked in at generation time.
# VITE_APP_TITLE=${{ values.title }}
