# @hookform/resolvers declares optional peers (ajv@^8, joi, yup, ...) for
# resolvers this app does not use, which conflicts with eslint's real
# ajv@^6 dependency. npm install tolerates the hoisted tree but `npm ci`
# rejects it as out-of-sync. legacy-peer-deps skips peer auto-resolution and
# installs exactly the locked tree - deterministic and reproducible.
legacy-peer-deps=true

# Quiet CI output.
fund=false
audit=false
