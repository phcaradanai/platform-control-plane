# Copy this file to .env and fill in real values. Never commit .env.
# Backstage does not auto-load .env files - see docs/getting-started.md
# for how to export these into your shell before running `yarn start`.

# --- GitHub integration (required for repository read/publish) ---
# Personal access token for the proof-of-concept phase. Needs repo scope
# for the target account. Will be replaced by a GitHub App when
# repositories move under a GitHub organization - see docs/github-integration.md.
GITHUB_TOKEN=

# --- GitHub OAuth sign-in (optional for local development) ---
# Leave empty to keep using the guest auth provider locally.
AUTH_GITHUB_CLIENT_ID=
AUTH_GITHUB_CLIENT_SECRET=

# --- PostgreSQL (used by docker-compose.yml and app-config.local.yaml) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=backstage
POSTGRES_PASSWORD=backstage
POSTGRES_DB=backstage
