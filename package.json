{
  "name": "root",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": "22 || 24"
  },
  "scripts": {
    "start": "dotenv -e .env -- backstage-cli repo start",
    "build:backend": "yarn workspace backend build",
    "build:all": "backstage-cli repo build --all",
    "build-image": "yarn workspace backend build-image",
    "tsc": "tsc",
    "tsc:full": "tsc --skipLibCheck false --incremental false",
    "clean": "backstage-cli repo clean",
    "test": "backstage-cli repo test",
    "test:all": "backstage-cli repo test --coverage",
    "test:e2e": "playwright test",
    "fix": "backstage-cli repo fix",
    "lint": "backstage-cli repo lint --since origin/main",
    "lint:all": "backstage-cli repo lint && yarn workspace @platform/ui lint && yarn workspace @platform/sdk lint",
    "prettier:check": "prettier --check .",
    "new": "backstage-cli new",
    "dev:app": "node .yarn/releases/yarn-4.13.0.cjs workspace app start",
    "dev:portal": "node .yarn/releases/yarn-4.13.0.cjs workspace @platform/ui storybook",
    "build:portal": "node .yarn/releases/yarn-4.13.0.cjs workspace @platform/ui storybook:build",
    "dev:backend": "node .yarn/releases/yarn-4.13.0.cjs workspace backend start",
    "test:e2e:smoke": "node .yarn/releases/yarn-4.13.0.cjs playwright test packages/app/e2e-tests/catalog.test.ts packages/app/e2e-tests/create.test.ts packages/app/e2e-tests/sign-in.test.ts"
  },
  "backstage": {
    "cli": {
      "new": {
        "globals": {
          "license": "UNLICENSED"
        }
      }
    }
  },
  "workspaces": [
    "packages/*",
    "plugins/*"
  ],
  "devDependencies": {
    "@backstage/cli": "^0.36.4",
    "@backstage/cli-defaults": "^0.1.4",
    "@backstage/e2e-test-utils": "^0.1.2",
    "@jest/environment-jsdom-abstract": "~30.2.0",
    "@playwright/test": "^1.32.3",
    "@storybook/addon-a11y": "10.5.7",
    "@storybook/react-vite": "10.5.7",
    "@types/jest": "^30.0.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@unocss/reset": "66.7.5",
    "dotenv-cli": "^11.0.0",
    "jest": "~30.2.0",
    "jsdom": "^27.1.0",
    "node-gyp": "^10.0.0",
    "prettier": "^2.3.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "storybook": "10.5.7",
    "typescript": "~5.8.0",
    "vite": "8.2.1"
  },
  "resolutions": {
    "@types/react": "^18",
    "@types/react-dom": "^18"
  },
  "prettier": "@backstage/cli/config/prettier",
  "jest": {
    "resolver": "<rootDir>/../../../jest.resolver.cjs"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  },
  "packageManager": "yarn@4.13.0"
}
